# Copie para ".env" na mesma pasta e ajuste se necessário.
# Dentro do Docker Compose da raiz, essas variáveis já são injetadas
# automaticamente (ver docker-compose.yml).

DATABASE_URL=postgresql://quarantine:quarantine@localhost:5432/quarantine_db

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=antifraud
RABBITMQ_PASSWORD=antifraud

# Contrato de integração com o Admin Panel Service.
RABBITMQ_EXCHANGE=antifraude.eventos
RABBITMQ_RELEASE_COMMAND_QUEUE=quarantine.comando-liberacao
RABBITMQ_RELEASE_COMMAND_ROUTING_KEY=comando.liberacao
RABBITMQ_QUARANTINE_ROUTING_KEY=conta.em-quarentena
RABBITMQ_RELEASED_ROUTING_KEY=conta.liberada

LOG_LEVEL=INFO
