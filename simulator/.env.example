# Caminhos relativos também são aceitos em execução local.
DATASET_PATH=./data/PS_20174392719_1491204439457_log.csv
DATASET_INDEX_PATH=./data/.cache/paysim.offsets

# Dentro do Docker Compose, o nome do serviço funciona como hostname.
API_GATEWAY_URL=http://api-gateway:8000
API_GATEWAY_ENDPOINT=/events/transactions

# "sequential" (padrão) percorre o CSV na ordem original, preservando os
# padrões temporais/de correlação entre contas de que o Risk Scoring Service
# vai depender (ver ADR 003/004 no README principal e a Issue #5).
# "random" sorteia linhas com reposição, ignorando a ordem — só recomendado
# para testes de carga/stress, não para simular o fluxo real do sistema.
SAMPLING_STRATEGY=sequential

# Onde o modo sequencial guarda a posição atual, para retomar a leitura de
# onde parou na próxima execução (em vez de recomeçar do início).
SEQUENTIAL_CHECKPOINT_PATH=./data/.cache/sequential_position.json
# A cada quantas mensagens o checkpoint é salvo em disco (a posição também é
# sempre salva ao encerrar o simulador, mesmo antes de atingir esse número).
CHECKPOINT_EVERY_MESSAGES=20

# Intervalo (em segundos) entre o envio de cada evento. Um valor aleatório é
# sorteado a cada envio dentro do intervalo [MIN, MAX] — em vez de um valor
# fixo — para simular um fluxo de transações mais realista (nenhum sistema
# real envia eventos com espaçamento perfeitamente constante). Os padrões
# abaixo são um ritmo "de demonstração", fácil de acompanhar nos logs; para
# aproximar do throughput real da PaySim (~2,4 transações/segundo, calculado
# a partir de 6.362.620 linhas em 744 steps de 1h), use algo como 0.2 / 0.6.
SEND_INTERVAL_MIN_SECONDS=0.5
SEND_INTERVAL_MAX_SECONDS=2.0
# Variável legada: se definida SOZINHA (sem as duas acima), vira um intervalo
# fixo (comportamento de versões anteriores deste arquivo). Deixe comentada.
# SEND_INTERVAL_SECONDS=1.0

REQUEST_TIMEOUT_SECONDS=5.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# 0 = execução contínua.
MAX_MESSAGES=0

# A PaySim recomenda não usar os saldos como atributos de detecção.
INCLUDE_BALANCE_FIELDS=false

# Não envie o gabarito ao motor antifraude por padrão.
INCLUDE_GROUND_TRUTH=false
STOP_ON_ERROR=false
LOG_LEVEL=INFO

# Usado apenas quando SAMPLING_STRATEGY=random, para tornar os sorteios
# reproduzíveis em depuração/testes.
# SIMULATOR_RANDOM_SEED=42