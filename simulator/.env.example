# Caminhos relativos também são aceitos em execução local.
DATASET_PATH=./data/PS_20174392719_1491204439457_log.csv
DATASET_INDEX_PATH=./data/.cache/paysim.offsets

# Dentro do Docker Compose, o nome do serviço funciona como hostname.
API_GATEWAY_URL=http://api-gateway:8000
API_GATEWAY_ENDPOINT=/events/transactions

SEND_INTERVAL_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=5.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# 0 = execução contínua.
MAX_MESSAGES=0

# A PaySim recomenda não usar os saldos como atributos de detecção.
INCLUDE_BALANCE_FIELDS=false

# Não envie o gabarito ao motor antifraude por padrão.
INCLUDE_GROUND_TRUTH=false
STOP_ON_ERROR=false
LOG_LEVEL=INFO

# Opcional: torna os sorteios reproduzíveis para depuração/testes.
# SIMULATOR_RANDOM_SEED=42
