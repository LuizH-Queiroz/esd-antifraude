# Copie para ".env" na mesma pasta e ajuste se necessário.
# Dentro do Docker Compose da raiz, essas variáveis já são injetadas
# automaticamente (ver docker-compose.yml).

# Ajuste a porta para a publicada no host pelo docker-compose.yml (confira
# o bloco "risk-scoring-db" — mesma lógica usada para o ingestion-db).
DATABASE_URL=postgresql://risk_scoring:risk_scoring@localhost:5432/risk_scoring_db

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=antifraud
RABBITMQ_PASSWORD=antifraud

RABBITMQ_EXCHANGE=antifraude.eventos
RABBITMQ_QUEUE=transacoes.registradas
RABBITMQ_ROUTING_KEY=transacao.registrada

# Fora do Docker, aponte para o .joblib gerado localmente por
# `python -m ml.train` (caminho relativo à raiz do repositório).
MODEL_PATH=../ml/artifacts/fraud_classifier.joblib

HIGH_RISK_THRESHOLD=0.5
LOG_LEVEL=INFO