# Copie este arquivo para ".env" na mesma pasta e ajuste se necessário.
# Dentro do Docker Compose da raiz, essas URLs já são injetadas automaticamente
# (ver docker-compose.yml) e não precisam ser sobrescritas.

# URLs base dos microsserviços internos para onde o Gateway roteia.
INGESTION_SERVICE_URL=http://localhost:8001
ADMIN_PANEL_SERVICE_URL=http://localhost:8004

# Path interno usado ao encaminhar eventos de transação ao Ingestion Service.
# Contrato provisório: ainda não existe uma Anti-corruption Layer definida no
# Ingestion Service (ver README principal).
INGESTION_EVENTS_PATH=/internal/transactions

# Timeout ao chamar um serviço interno. Mantido baixo de propósito: enquanto
# os serviços de destino não existem, o Gateway deve falhar rápido (503) em
# vez de travar a requisição esperando uma resposta que nunca vem.
DOWNSTREAM_TIMEOUT_SECONDS=3.0

LOG_LEVEL=INFO