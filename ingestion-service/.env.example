# Copie para ".env" na mesma pasta e ajuste se necessário.
# Dentro do Docker Compose da raiz, essas variáveis já são injetadas
# automaticamente (ver docker-compose.yml) e não precisam ser sobrescritas.

DATABASE_URL=postgresql://ingestion:ingestion@localhost:5433/ingestion_db

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=antifraud
RABBITMQ_PASSWORD=antifraud

# Topologia do RabbitMQ (ver README para detalhes/motivação).
RABBITMQ_EXCHANGE=antifraude.eventos
RABBITMQ_QUEUE=ingestion.transacao-registrada
RABBITMQ_ROUTING_KEY=transacao.registrada

LOG_LEVEL=INFO